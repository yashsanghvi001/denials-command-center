# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change_me
# Optional override of the "today" used for deadlines; the default lives in appsettings.json.
# Ingestion__Today=2026-09-30
# Used when running the API outside compose; compose builds this from POSTGRES_PASSWORD.
# ConnectionStrings__Denials=Host=localhost;Database=denials;Username=denials;Password=change_me
# Compose sets this to /data inside the container.
# Ingestion__DataDirectory=./data
# Optional. Without a key the system uses rule-based template letters (degraded mode).
# Gemini__ApiKey=
# Gemini__Model=gemini-2.5-flash
# Most model calls per UTC day (cached answers are free and not counted twice).
# Gemini__DailyCallLimit=200
# Password for the seeded users (manager, karan, priya, anjali, rahul). Set before the first start.
Auth__SeedPassword=change-me-locally
# Optional: "Forgot password?" emails through Microsoft Graph. The link only appears when all four Graph values are set.
# The app registration needs the Mail.Send application permission with admin consent.
# Graph__TenantId=
# Graph__ClientId=
# Graph__ClientSecret=
# Graph__SenderAddress=denials@yourpractice.com
# Where each user's reset email goes (one line per user).
# Auth__Emails__manager=manager@yourpractice.com
# Auth__Emails__priya=priya@yourpractice.com
# Address used in reset links; change it if the app is not opened at this URL.
# App__PublicUrl=http://127.0.0.1:3000
